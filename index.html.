const destinations = [
{name:"Goa",region:"West India · Coast",category:"beach",image:"https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?auto=format&fit=crop&w=1000&q=80",intro:"A coastal state known for beaches, Portuguese-influenced heritage, colourful markets, seafood and a relaxed holiday atmosphere.",tags:["Beaches","Heritage","Food","Coastal drives"],attractions:"Old Goa churches; Fontainhas in Panaji; Fort Aguada; beaches around Candolim, Colva and Palolem; local markets. Check access rules and seasonal conditions.",hotels:[["Taj Fort Aguada Resort & Spa","Sinquerim · premium resort","https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=700&q=80"],["The Leela Goa","Mobor · luxury resort","https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=700&q=80"],["Bloom Hotel","Selected Goa locations · mid-range","https://images.unsplash.com/photo-1564501049412-61c2a3083791?auto=format&fit=crop&w=700&q=80"]],food:"Goan fish curry, poi bread, bebinca and local vegetarian dishes. Try licensed eateries and ask about ingredients and spice levels.",transport:"Dabolim and Manohar international airports serve different parts of Goa. Rail stations include Madgaon and Thivim. Use licensed taxis, public buses or verified rental providers.",duration:"3–5 days",season:"November–February is often more comfortable. Monsoon months bring heavy rain and changing sea conditions.",itinerary:"Day 1: Panaji and Fontainhas. Day 2: Old Goa heritage sites and nearby markets. Day 3: Choose a north or south Goa beach area. Add a rest day or local food experience if time allows.",note:"Beach flags, swimming conditions and monsoon restrictions can change. Follow lifeguard instructions and check current local advisories.",map:"Goa India"},
{name:"Jaipur",region:"Rajasthan · Heritage",category:"heritage",image:"https://images.unsplash.com/photo-1599661046827-dacff0c0f09a?auto=format&fit=crop&w=1000&q=80",intro:"The Pink City blends Rajput architecture, historic forts, lively bazaars, traditional crafts and distinctive Rajasthani food.",tags:["Forts","Palaces","Crafts","Food"],attractions:"Amber Fort; City Palace; Hawa Mahal; Jantar Mantar; Nahargarh Fort; bazaars around Johari and Bapu markets. Check monument hours and ticket rules.",hotels:[["Rambagh Palace","Luxury heritage hotel","https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=700&q=80"],["ITC Rajputana","Central Jaipur · premium","https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=700&q=80"],["Hotel Pearl Palace","Jaipur · budget boutique option","https://images.unsplash.com/photo-1564501049412-61c2a3083791?auto=format&fit=crop&w=700&q=80"]],food:"Dal baati churma, ghewar, pyaaz kachori and Rajasthani thalis. Explore established food areas and choose hygienic vendors.",transport:"Jaipur International Airport and Jaipur Junction connect the city. Metro, city buses, auto-rickshaws and app-based taxis operate in many areas.",duration:"2–3 days",season:"October–March is generally cooler for sightseeing. Summer afternoons can be very hot.",itinerary:"Day 1: City Palace, Jantar Mantar and Hawa Mahal area. Day 2: Amber Fort and nearby viewpoints. Day 3: Markets, crafts and a local food walk.",note:"Dress respectfully at religious sites, confirm entry fees from official sources and use authorised guides where possible.",map:"Jaipur Rajasthan India"},
{name:"Manali",region:"Himachal Pradesh · Mountains",category:"mountain",image:"https://images.unsplash.com/photo-1626621341517-bbf3d9990a23?auto=format&fit=crop&w=1000&q=80",intro:"A Himalayan town popular for mountain scenery, riverside landscapes, village culture and access to outdoor experiences.",tags:["Mountains","Nature","Culture","Snow season"],attractions:"Old Manali; Hadimba Devi Temple; Vashisht; Naggar; Solang Valley subject to weather and permitted activities. Rohtang access requires current permits and conditions.",hotels:[["The Himalayan","Manali · heritage-style stay","https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=700&q=80"],["Span Resort & Spa","Near Manali · riverside resort","https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=700&q=80"],["Johnson Lodge","Manali · lodge option","https://images.unsplash.com/photo-1564501049412-61c2a3083791?auto=format&fit=crop&w=700&q=80"]],food:"Siddu, madra, dham-style meals, trout dishes and local Himachali food. Ask about ingredients and seasonal availability.",transport:"The nearest broad-gauge railhead is not in Manali; many visitors travel by road from Kullu or use buses from major north Indian cities. Confirm road conditions before departure.",duration:"3–5 days",season:"Spring and autumn can be pleasant. Winter access and snowfall vary; monsoon rain can affect roads.",itinerary:"Day 1: Explore Manali town and Old Manali. Day 2: Hadimba Temple and nearby villages. Day 3: Choose a permitted valley excursion after checking road and weather updates.",note:"Mountain weather and road conditions can change quickly. Use authorised operators, avoid risky roadside stops and follow local administration advisories.",map:"Manali Himachal Pradesh India"},
{name:"Kerala",region:"South India · Backwaters & hills",category:"nature",image:"https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?auto=format&fit=crop&w=1000&q=80",intro:"A diverse state of backwaters, hill landscapes, beaches, wildlife areas, spice-growing regions and rich cultural traditions.",tags:["Backwaters","Hill stations","Culture","Nature"],attractions:"Alappuzha backwaters; Fort Kochi; Munnar tea landscapes; Periyar region; Varkala coast. Distances are significant, so choose a manageable route.",hotels:[["Kumarakom Lake Resort","Kumarakom · backwater luxury","https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=700&q=80"],["Brunton Boatyard","Fort Kochi · heritage hotel","https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=700&q=80"],["Tea County","Munnar · hill stay","https://images.unsplash.com/photo-1564501049412-61c2a3083791?auto=format&fit=crop&w=700&q=80"]],food:"Appam and stew, puttu and kadala curry, Kerala sadya, seafood and regional vegetarian dishes served on banana leaves.",transport:"Kochi, Thiruvananthapuram and Kozhikode airports connect different regions. Trains, buses, taxis and licensed boat operators help with local travel.",duration:"5–7 days",season:"November–February is often milder. Monsoon travel can be beautiful but requires weather-aware planning.",itinerary:"Day 1: Kochi heritage quarter. Days 2–3: Munnar. Days 4–5: Alappuzha or Kumarakom backwaters. Add more days for southern beaches.",note:"Choose licensed houseboat operators and check life jackets, weather and safety arrangements before boarding.",map:"Kerala India"},
{name:"Udaipur",region:"Rajasthan · Lakes & palaces",category:"heritage",image:"https://images.unsplash.com/photo-1595658658481-d53d3f999875?auto=format&fit=crop&w=1000&q=80",intro:"Often called the City of Lakes, Udaipur is known for its palaces, lake views, historic streets, crafts and Mewar heritage.",tags:["Lakes","Palaces","Heritage","Arts"],attractions:"City Palace; Lake Pichola; Jagdish Temple; Saheliyon ki Bari; Bagore Ki Haveli; Monsoon Palace viewpoints. Boat services depend on conditions.",hotels:[["The Oberoi Udaivilas","Lake Pichola · luxury hotel","https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=700&q=80"],["Taj Lake Palace","Lake Pichola · heritage hotel","https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=700&q=80"],["Trident Udaipur","Lake Pichola area · premium","https://images.unsplash.com/photo-1564501049412-61c2a3083791?auto=format&fit=crop&w=700&q=80"]],food:"Dal baati churma, gatte ki sabzi, ker sangri, laal maas and local sweets. Vegetarian options are widely available.",transport:"Maharana Pratap Airport, Udaipur City railway station and intercity buses connect the city. Auto-rickshaws and taxis are common.",duration:"2–3 days",season:"October–March is generally more comfortable. Summer temperatures can be high.",itinerary:"Day 1: City Palace, Jagdish Temple and old-city lanes. Day 2: Lake Pichola boat ride if operating, gardens and cultural performances. Day 3: Sajjangarh or local crafts.",note:"Check official boat schedules and monument hours. Respect photography restrictions at religious and heritage sites.",map:"Udaipur Rajasthan India"},
