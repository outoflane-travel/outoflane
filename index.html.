<div class="modal" id="destinationModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" onclick="if(event.target===this)closeModal()"><div class="modal-box"><button class="modal-close" aria-label="Close" onclick="closeModal()">×</button><div class="kicker">Destination guide</div><h2 id="modalTitle"></h2><p id="modalDescription"></p><div class="modal-meta" id="modalMeta"></div><h3>Ideas to explore</h3><p id="modalIdeas"></p><div class="modal-actions"><a class="btn primary" id="modalMap" target="_blank" rel="noopener">Open in Google Maps ↗</a><button class="btn secondary" onclick="closeModal();document.getElementById('planner').scrollIntoView()">Plan a trip</button></div><p class="notice">Check official tourism sources and current local information before making travel plans.</p></div></div>
