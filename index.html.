<script>
const destinationData={
Goa:{description:"Goa is known for its coastline, Portuguese-influenced heritage, markets and varied food culture. You can balance beach time with heritage walks and quieter village experiences.",meta:["West India","Coast","Beaches & heritage"],ideas:"Explore Panaji's Latin Quarter, Old Goa's historic churches, local markets and the beaches that suit your pace.",map:"Goa India"},
Jaipur:{description:"Jaipur, Rajasthan's capital, is known for its planned old city, pink-toned architecture, forts, crafts and lively bazaars.",meta:["Rajasthan","Heritage","Forts & markets"],ideas:"Explore Hawa Mahal, Amber Fort, City Palace, Jantar Mantar and the old city's traditional markets.",map:"Jaipur Rajasthan"},
Manali:{description:"Manali is a Himalayan town surrounded by mountain scenery, forests and the Beas River valley. Weather and road access can vary by season.",meta:["Himachal Pradesh","Mountains","Nature & outdoors"],ideas:"Explore Old Manali, Hadimba Temple, nearby villages and viewpoints. Check weather and local travel advisories before heading to high-altitude areas.",map:"Manali Himachal Pradesh"},
Kerala:{description:"Kerala offers a mix of backwaters, hill stations, beaches and cultural traditions across its coastal and inland regions.",meta:["South India","Nature","Backwaters & hills"],ideas:"Consider Alleppey backwaters, Fort Kochi, Munnar's tea-growing landscapes and local food experiences.",map:"Kerala India"},
Udaipur:{description:"Udaipur is a historic city in Rajasthan, celebrated for its lakes, palaces, crafts and views of the Aravalli hills.",meta:["Rajasthan","Heritage","Lakes & palaces"],ideas:"Explore City Palace, Lake Pichola, Jagdish Temple, Saheliyon-ki-Bari and the old city's lanes.",map:"Udaipur Rajasthan"},
Rishikesh:{description:"Rishikesh sits beside the Ganges at the foothills of the Himalayas and is known for riverfront settings, yoga traditions and nearby nature.",meta:["Uttarakhand","Nature","River & culture"],ideas:"Visit the riverfront ghats, explore local cafes and learn about the area's yoga and spiritual heritage. Follow local safety guidance near the river.",map:"Rishikesh Uttarakhand"}
};
function showDestination(name){const d=destinationData[name];document.getElementById('modalTitle').textContent=name;document.getElementById('modalDescription').textContent=d.description;document.getElementById('modalIdeas').textContent=d.ideas;document.getElementById('modalMeta').innerHTML=d.meta.map(x=>'<span class="pill">'+x+'</span>').join('');document.getElementById('modalMap').href='https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(d.map);document.getElementById('destinationModal').classList.add('show')}
function closeModal(){document.getElementById('destinationModal').classList.remove('show')}
function openAccount(){document.getElementById('accountModal').classList.add('show')}
function closeAccount(){document.getElementById('accountModal').classList.remove('show')}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();closeAccount()}})
let activeFilter='all';
function filterCards(){const q=document.getElementById('search').value.toLowerCase();let visible=0;document.querySelectorAll('.card').forEach(c=>{const matchText=c.dataset.search.includes(q)||c.innerText.toLowerCase().includes(q);const matchCategory=activeFilter==='all'||c.dataset.category===activeFilter;c.style.display=matchText&&matchCategory?'':'none';if(matchText&&matchCategory)visible++});let empty=document.getElementById('emptyResults');if(!visible&&!empty){empty=document.createElement('div');empty.id='emptyResults';empty.className='empty';empty.textContent='No destinations found. Try another search.';document.getElementById('cards').appendChild(empty)}else if(visible&&empty)empty.remove()}
document.getElementById('search').addEventListener('input',filterCards);
document.querySelectorAll('.filter').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));b.classList.add('active');activeFilter=b.dataset.filter;filterCards()}));
function calculate(){const p=Math.max(1,Math.min(20,Number(document.getElementById('people').value)||1));const d=Math.max(1,Math.min(60,Number(document.getElementById('days').value)||1));const a=Math.max(0,Number(document.getElementById('daily').value)||0);document.getElementById('estimate').textContent='₹'+(p*d*a).toLocaleString('en-IN');document.getElementById('estimateNote').textContent=p+' traveller(s) × '+d+' day(s) × ₹'+a.toLocaleString('en-IN')+' per person/day.'}
function prepareTrip(){calculate();const s='OUTOFLANE TRIP IDEA\\nDestination: '+document.getElementById('destination').value+'\\nTravellers: '+document.getElementById('people').value+'\\nDays: '+document.getElementById('days').value+'\\nEstimated group budget: '+document.getElementById('estimate').textContent;document.getElementById('tripSummary').textContent=s.replaceAll('\\n',' · ');if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(s).catch(()=>{});}
function sendMessage(e){e.preventDefault();const n=document.getElementById('name').value.trim(),mail=document.getElementById('email').value.trim(),msg=document.getElementById('message').value.trim();const subject=encodeURIComponent('OUTOFLANE website enquiry');const body=encodeURIComponent('Name: '+n+'\\nEmail: '+mail+'\\n\\n'+msg);window.location.href='mailto:hello@outoflane.example?subject='+subject+'&body='+body}
calculate();
</script>
</body></html>