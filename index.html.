const hotelExtras=[
["The Leela Goa","Goa","Luxury beach resort"],
["Rambagh Palace","Jaipur","Heritage luxury"],
["Span Resort & Spa","Manali","Riverside mountain stay"],
["Kumarakom Lake Resort","Kerala","Backwater resort"],
["The Oberoi Udaivilas","Udaipur","Lakefront luxury"],
["Aloha on the Ganges","Rishikesh","Riverside stay"]
];
let currentPlace="";let saved=[];try{saved=JSON.parse(localStorage.getItem("outoflane_saves")||"[]");if(!Array.isArray(saved))saved=[]}catch(e){saved=[]}
function renderCards(){const q=document.getElementById("search").value.toLowerCase();const active=document.querySelector(".filter.active")?.dataset.filter||"all";const onlySaved=document.getElementById("savedFilter").classList.contains("active");const grid=document.getElementById("destinationGrid");grid.innerHTML="";let n=0;destinations.forEach(d=>{if(active!=="all"&&d.category!==active)return;if(onlySaved&&!saved.includes(d.name))return;if(!(d.name+" "+d.region+" "+d.tags.join(" ")).toLowerCase().includes(q))return;n++;const c=document.createElement("article");c.className="card";c.innerHTML=`<img src="${d.image}" alt="${d.name} destination" loading="lazy"><div class="cardbody"><div class="tag">${d.region}</div><h3>${d.name}</h3><p>${d.intro}</p><div class="cardfoot"><button class="linkbtn ${saved.includes(d.name)?"saved":""}" onclick="toggleSave('${d.name}')">${saved.includes(d.name)?"♥ Saved":"♡ Save"}</button><button class="linkbtn" onclick="openDestination('${d.name}')">Explore guide ↗</button></div></div>`;grid.appendChild(c)});if(!n)grid.innerHTML="<p>No destinations match your search. Try another keyword.</p>";document.getElementById("savedCount").textContent=saved.length}
function toggleSave(name){saved=saved.includes(name)?saved.filter(x=>x!==name):[...saved,name];try{localStorage.setItem("outoflane_saves",JSON.stringify(saved))}catch(e){};if(currentPlace===name){document.getElementById("savePlace").textContent=saved.includes(name)?"♥ Saved to your list":"♡ Save destination"}renderCards()}
function openDestination(name){const d=destinations.find(x=>x.name===name);if(!d)return;currentPlace=name;document.getElementById("modalImage").src=d.image;document.getElementById("modalImage").alt=d.name;document.getElementById("modalRegion").textContent=d.region;document.getElementById("modalTitle").textContent=d.name;document.getElementById("modalIntro").textContent=d.intro;document.getElementById("modalTags").innerHTML=d.tags.map(t=>`<span class="chip">${t}</span>`).join("");document.getElementById("modalAttractions").textContent=d.attractions;document.getElementById("modalFood").textContent=d.food;document.getElementById("modalTransport").textContent=d.transport;document.getElementById("modalDuration").textContent=d.duration;document.getElementById("modalSeason").textContent=d.season;document.getElementById("modalItinerary").textContent=d.itinerary;document.getElementById("modalNote").textContent=d.note;document.getElementById("modalHotels").innerHTML=d.hotels.map(h=>`<div class="hotel"><img src="${h[2]}" alt="${h[0]}" loading="lazy"><b>${h[0]}</b><small>${h[1]} · ${h[2]?"Hotel suggestion":""}<br>${h[2]}</small></div>`).join("");document.getElementById("savePlace").textContent=saved.includes(name)?"♥ Saved to your list":"♡ Save destination";document.getElementById("mapLink").href="https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(d.map);document.getElementById("modal").classList.add("show");document.body.style.overflow="hidden"}
function closeModal(){document.getElementById("modal").classList.remove("show");document.body.style.overflow=""}
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeModal()});
document.querySelectorAll("[data-filter]").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll("[data-filter]").forEach(x=>x.classList.remove("active"));b.classList.add("active");renderCards()}));
document.getElementById("savedFilter").addEventListener("click",e=>{e.currentTarget.classList.toggle("active");renderCards()});document.getElementById("search").addEventListener("input",renderCards);
function estimate(){const p=Math.max(1,Math.min(20,Number(document.getElementById("people").value)||1));const d=Math.max(1,Math.min(30,Number(document.getElementById("days").value)||1));const style=document.getElementById("style").value;const base={budget:2200,mid:4500,premium:9000}[style];const total=base*p*d;document.getElementById("estimate").textContent="₹ "+total.toLocaleString("en-IN");document.getElementById("estimateNote").textContent="Indicative planning estimate for "+p+" traveller(s) over "+d+" day(s), excluding or varying by long-distance transport, season and personal choices. Check actual prices before booking."}
function sendEnquiry(e){e.preventDefault();const n=document.getElementById("name").value;const em=document.getElementById("email").value;const m=document.getElementById("message").value;const subject=encodeURIComponent("OUTOFLANE website enquiry");const body=encodeURIComponent("Name: "+n+"\nEmail: "+em+"\n\nMessage:\n"+m);location.href="mailto:outoflane1@gmail.com?subject="+subject+"&body="+body}
document.getElementById("stayHighlights").innerHTML=hotelExtras.map(h=>`<div class="feature"><b>${h[0]}</b><p>${h[1]} · ${h[2]}. Check the hotel's official website for current facilities, room types, policies and rates.</p></div>`).join("");
renderCards();estimate();
</script></body></html>